<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Основной прогон: mvn test
    В набор входят ShareLane и Swag Labs. Тесты The Internet (herokuapp) временно исключены —
    сайт нестабилен и подвешивает прогон; для них есть отдельный набор testng-herokuapp.xml.

    По умолчанию используется Chrome; другой браузер — mvn test -Dbrowser=firefox,
    безголовый режим — mvn test -Dheadless=true, системный прокси — mvn test -Dproxy=system.
-->
<suite name="Practice UI autotests" verbose="1">
    <!-- Повтор только инфраструктурных сбоев (браузер закрылся): см. tests.BrowserCrashRetryAnalyzer -->
    <listeners>
        <listener class-name="tests.RetryListener"/>
    </listeners>
    <test name="UI-автотесты: ShareLane и Swag Labs">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="false"/>
        <packages>
            <package name="tests.sharelane"/>
            <package name="tests.saucedemo"/>
        </packages>
    </test>
</suite>
