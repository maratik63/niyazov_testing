<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Прогон: mvn test
    По умолчанию используется Chrome; другой браузер — mvn test -Dbrowser=firefox,
    безголовый режим — mvn test -Dheadless=true, системный прокси — mvn test -Dproxy=system.
-->
<suite name="Practice UI autotests" verbose="1">
    <test name="ShareLane и The Internet: UI-автотесты">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="false"/>
        <packages>
            <package name="tests"/>
        </packages>
    </test>
</suite>
