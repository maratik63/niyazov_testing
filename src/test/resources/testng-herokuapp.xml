<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Отдельный набор для практики №12 (The Internet / herokuapp).
    Запуск: mvn test -Dsurefire.suiteXmlFiles=src/test/resources/testng-herokuapp.xml

    Набор вынесен из основного прогона: сайт the-internet.herokuapp.com периодически
    отвечает крайне медленно или не отдаёт страницы, из-за чего весь прогон зависает.
-->
<suite name="Practice 12: The Internet (herokuapp)" verbose="1">
    <test name="UI-автотесты The Internet">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="false"/>
        <packages>
            <package name="tests.herokuapp"/>
        </packages>
    </test>
</suite>
