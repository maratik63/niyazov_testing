<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Кроссбраузерный параллельный прогон тестов Swag Labs:
        mvn clean test -Pcrossbrowser

    Браузеры Chrome и Firefox прогоняются параллельно (parallel="tests", thread-count="2").
    Блок Edge готов, но закомментирован: на текущей машине Microsoft Edge не установлен,
    а драйвер без браузера запустить нельзя. После установки Edge уберите комментарий
    и увеличьте thread-count до 3.
-->
<suite name="CrossBrowser Swag Labs" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="tests.RetryListener"/>
    </listeners>

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="false"/>
        <packages>
            <package name="tests.saucedemo"/>
        </packages>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <parameter name="headless" value="false"/>
        <packages>
            <package name="tests.saucedemo"/>
        </packages>
    </test>

    <!--
    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <parameter name="headless" value="false"/>
        <packages>
            <package name="tests.saucedemo"/>
        </packages>
    </test>
    -->
</suite>
